# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=

# Set to 1 to run the whole app with NO Sarvam calls (canned text + silent mp3).
# Handy for frontend work. With STUB_MODE=1, SARVAM_API_KEY may be blank.
STUB_MODE=0

# Optional model / voice overrides (defaults shown)
SARVAM_STT_MODEL=saaras:v3
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TRANSLATE_MODE=modern-colloquial
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_SAMPLE_RATE=22050
# Per-language voice override, e.g.:
# SARVAM_TTS_SPEAKER_TA=vidya

# Set to 1 to write the last uploaded clip to samples/_last.<ext> for debugging
DEBUG=0
